{
  "manifest_version": 3,
  "name": "Todo AI LinkedIn Candidate Finder",
  "version": "0.1.2",
  "description": "LinkedIn sourcing for Todo AI. Scores visible profiles against the selected requirement and sends chosen candidates to Todo AI.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://todo-resume-intelligence.vercel.app/*",
    "https://todo.talent-stock.com/*",
    "https://todo-resume-intelligence-git-a52e9c-shivsingh556-6346s-projects.vercel.app/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Todo AI Candidate Finder"},
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://todo-resume-intelligence.vercel.app/*",
        "https://todo.talent-stock.com/*",
        "https://todo-resume-intelligence-git-a52e9c-shivsingh556-6346s-projects.vercel.app/*"
      ],
      "js": ["content-todo.js"],
      "run_at": "document_idle"
    }
  ]
}
